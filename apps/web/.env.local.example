# Postgres connection string (Neon). If unset, falls back to a JSON-file
# store under apps/web/data/ so the demo works without a live database.
DATABASE_URL=

# Private key of a funded Hardhat local account, used by /api/validate and
# /api/reward/claim to submit transactions on behalf of the demo user.
# Default Hardhat account #0:
DEMO_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Local Hardhat node RPC URL.
CHAIN_RPC_URL=http://127.0.0.1:8545

# Optional overrides if packages/contracts/deployed.json is unavailable.
ATTESTATION_REGISTRY_ADDRESS=
CONTRIBUTOR_REGISTRY_ADDRESS=
REWARD_DISTRIBUTOR_ADDRESS=
