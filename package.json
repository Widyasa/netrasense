{
  "name": "netrasense",
  "private": true,
  "version": "0.0.1",
  "description": "NetraSense — hackathon R0 MVP (web-based)",
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm -r build",
    "chain": "pnpm --filter contracts chain",
    "deploy:contracts": "pnpm --filter contracts deploy",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "format": "pnpm -r format",
    "mobile:dev": "pnpm --filter @netrasense/mobile dev",
    "mobile:android": "pnpm --filter @netrasense/mobile android",
    "mobile:build": "pnpm --filter @netrasense/mobile build"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@10.24.0",
  "pnpm": {
    "onlyBuiltDependencies": ["core-js", "esbuild", "keccak", "secp256k1", "unrs-resolver"]
  }
}
